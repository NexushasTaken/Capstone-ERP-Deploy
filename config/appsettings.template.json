{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Urls": "http://localhost:5176",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=__DB_PORT__;Database=ERP;User Id=erp;Password=__DB_PASSWORD__;"
  },

  "Jwt": {
    "Key": "__JWT_KEY__",
    "Issuer": "ERP",
    "Audience": "employee",
    "ExpireInDays": 30
  },

  "HttpContextSettings": {
    "InDevelopment": false,
    "IsHttpOnly": true,
    "SameSite": "Lax",
    "ExpireInDays": 30
  },

  "AllowedHosts": "*"
}
